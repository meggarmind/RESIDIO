# Residio — container environment template.
#
# Copy to `.env.docker` and fill in. `.env.docker` is gitignored and is excluded
# from the Docker build context by `.dockerignore`, so it can hold real values.
# THIS file is committed to a PUBLIC repository: placeholders only, never a real
# credential of any kind.
#
# The split below is not cosmetic. It is the security boundary of the image.
# See docs/deployment/docker.md.

# ==============================================================================
# BUILD-TIME  (baked into the image, environment-specific)
# ==============================================================================
# Next.js inlines every NEXT_PUBLIC_* value into the client JavaScript bundle
# during `next build`. They are passed to `docker build` as --build-arg and are
# PUBLIC by construction — anyone who loads the app can read them.
#
# Consequence: the image is bound to one environment. An image built with Stage
# values cannot be promoted to Prod. Build once per target.

# Selects which Supabase credential set src/lib/supabase/config.ts reads:
# 'cloud' uses the _CLOUD variables, 'local' uses the _LOCAL ones.
NEXT_PUBLIC_ENV_MODE=cloud

# Cloud Supabase project the browser and server clients talk to.
NEXT_PUBLIC_SUPABASE_URL_CLOUD=https://your-project-ref.supabase.co
# Anon key. RLS-constrained and safe to expose; this is NOT the service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY_CLOUD=your-anon-key

# Local Supabase project. Only read when NEXT_PUBLIC_ENV_MODE=local; leave unset
# for a container build, which always targets Supabase Cloud.
NEXT_PUBLIC_SUPABASE_URL_LOCAL=
NEXT_PUBLIC_SUPABASE_ANON_KEY_LOCAL=

# Unsuffixed fallbacks. src/lib/supabase/config.ts never reads these; a few
# standalone scripts do. Harmless to leave blank for the container.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of this deployment. Used to build the OAuth callback
# (`${NEXT_PUBLIC_SITE_URL}/auth/callback`), which must also be listed under
# Supabase -> Authentication -> URL Configuration -> Redirect URLs.
NEXT_PUBLIC_SITE_URL=https://residio.example.com
# Public origin used for absolute links in generated content (emails, PDFs).
NEXT_PUBLIC_APP_URL=https://residio.example.com

# Paystack public/publishable key, used by the browser checkout widget.
NEXT_PUBLIC_PAYSTACK_KEY=pk_test_placeholder
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_placeholder

# ==============================================================================
# RUNTIME  (injected on container start, never in the image)
# ==============================================================================
# Read only by server code, at request time. None of these appears as an ARG or
# an ENV in the Dockerfile, and none may be added there — an ARG lands in
# `docker history` and an ENV in `docker inspect`, which would publish the secret
# to anyone who can pull the image.
#
# Locally these arrive via docker-compose `env_file`. On Coolify they are set as
# the application's environment variables (marked as build-time = off).

# --- Supabase server credentials ----------------------------------------------
# Bypasses every RLS policy. The single most sensitive value in this file.
SUPABASE_SERVICE_ROLE_KEY_CLOUD=your-service-role-key
# Local-mode equivalent; leave blank for a Cloud deployment.
SUPABASE_SERVICE_ROLE_KEY_LOCAL=
# Unsuffixed fallback read by some standalone scripts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Encryption ---------------------------------------------------------------
# 32-byte hex key encrypting secrets at rest in the database (WhatsApp
# credentials, OAuth tokens). Rotating it orphans everything already encrypted.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=your-32-byte-hex-key
# Separate key for stored Gmail OAuth tokens used by the email-import feature.
GMAIL_TOKEN_ENCRYPTION_KEY=your-32-byte-hex-key

# --- Automation ---------------------------------------------------------------
# Shared secret the /api/cron/* routes require in the Authorization header.
# src/lib/auth/cron-auth.ts FAILS CLOSED in production when this is unset, so a
# production container without it has no working scheduled jobs at all.
CRON_SECRET=your-cron-secret

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=re_placeholder
# From address on outbound mail; its domain must be verified in Resend.
EMAIL_FROM_ADDRESS=noreply@residio.example.com
# Reply-To on outbound mail.
EMAIL_REPLY_TO_ADDRESS=support@residio.example.com

# --- Payments (Paystack) ------------------------------------------------------
# Server-side secret key for initialising and verifying transactions.
PAYSTACK_SECRET_KEY=sk_test_placeholder
# Secret used to verify the signature on inbound Paystack webhooks.
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret

# --- Google OAuth (Gmail email import) ----------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match a redirect URI registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://residio.example.com/api/auth/google/callback

# --- SMS (Termii) -------------------------------------------------------------
TERMII_API_KEY=your-termii-api-key
# Registered alphanumeric sender ID shown on delivered messages.
TERMII_SENDER_ID=Residio

# --- WhatsApp (legacy fallback) -----------------------------------------------
# Superseded once credentials are saved at /settings/whatsapp; the database
# values take precedence. Safe to leave unset on a new deployment.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com

# --- Runtime mode -------------------------------------------------------------
# Set to `production` by the Dockerfile's runner stage. Listed for completeness;
# do not override it here.
# NODE_ENV=production
