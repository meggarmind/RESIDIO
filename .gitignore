# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Development inbox prompts (auto-generated from Notion)
prompts/
processed/
deferred/
archived/

# MCP configuration (contains secrets)
.mcp.json

# TestSprite temporary files
testsprite_tests/tmp/

# Playwright artifacts (reports, traces, screenshots)
/playwright-report/
/test-results/

# Scratch / ad-hoc files in repo root
/re_match.ts
/testFile.txt
/testsprite/
/testsprite_tests/
/.playwright-mcp/

# Isolated agent worktrees
/.worktrees/

# Logs
*.log
logs/

docs/features/Email-import/E-Statement of November - 2025 for Account no 20204XXXXX.eml
docs/features/Email-import/Email-import/FirstBank Alert on Your Account - Credit.eml

# Windows Alternate Data Streams
*:Zone.Identifier

# Local tool state (ForgeStudio, skill observations)
/.forgestudio/
/skill-observations/
