# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which carries no secrets and is the only place a new
# deployer can discover what the app needs. It was previously force-added on a
# feature branch, which meant edits to it silently failed to commit.
!.env.example
# Same reasoning for the container template. Placeholders only; the developer's
# filled-in copy is .env.docker, which stays ignored by the rule above.
!.env.docker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

archived/

# MCP configuration (contains secrets)
.mcp.json

# TestSprite temporary files
testsprite_tests/tmp/

# Playwright artifacts (reports, traces, screenshots)
/playwright-report/
/test-results/

# Scratch / ad-hoc files in repo root
/re_match.ts
/testFile.txt
/testsprite/
/testsprite_tests/
/.playwright-mcp/

# Isolated agent worktrees
/.worktrees/

# Logs
*.log
logs/

docs/features/Email-import/E-Statement of November - 2025 for Account no 20204XXXXX.eml
docs/features/Email-import/Email-import/FirstBank Alert on Your Account - Credit.eml

# Windows Alternate Data Streams
*:Zone.Identifier

# Local tool state (ForgeStudio, skill observations)
/.forgestudio/
/skill-observations/

# Machine-local agent/tooling state - never belongs on master
.base/
.claude/worktrees/

# Per-machine Claude Code settings: never tracked (#263).
# It accumulates machine-local permission rules that have twice carried
# credential literals into a public repo.
.claude/settings.local.json
