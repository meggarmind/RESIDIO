# Copy to .env.local and fill in. Never commit .env.local.

# Which Supabase project the app talks to: 'local' or 'cloud'.
# src/lib/supabase/config.ts picks the _LOCAL or _CLOUD variables based on this.
NEXT_PUBLIC_ENV_MODE=cloud

# --- Cloud Supabase project ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL_CLOUD=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY_CLOUD=
# Bypasses every RLS policy. Server-side only — never expose to the browser and
# never hardcode it into a script that gets committed.
SUPABASE_SERVICE_ROLE_KEY_CLOUD=

# --- Local Supabase project (only needed when NEXT_PUBLIC_ENV_MODE=local) -----
NEXT_PUBLIC_SUPABASE_URL_LOCAL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY_LOCAL=
SUPABASE_SERVICE_ROLE_KEY_LOCAL=

# --- Public site URL ----------------------------------------------------------
# Used to build the OAuth redirect (`${NEXT_PUBLIC_SITE_URL}/auth/callback`).
# Falls back to window.location.origin when unset, so local dev needs nothing here.
# Whatever value is used must be listed under Supabase → Authentication →
# URL Configuration → Redirect URLs, or the callback silently bounces to the Site URL.
#
# Note that the redirect URI registered in Google Cloud Console is NOT this value —
# it is always https://<project-ref>.supabase.co/auth/v1/callback, which is the same
# for every environment.
NEXT_PUBLIC_SITE_URL=

# --- Automation ---------------------------------------------------------------
# Shared secret for cron-triggered routes (invoice generation, reminders).
CRON_SECRET=

# --- Encryption ---------------------------------------------------------------
# 32-byte key for encrypting secrets in the database (WhatsApp credentials, OAuth tokens, etc).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# --- WhatsApp (Legacy Fallback) ------------------------------------------------
# LEGACY: these variables are a fallback for backward compatibility.
# Once an admin saves WhatsApp credentials at /settings/whatsapp in the dashboard,
# the database values take precedence and these environment variables are ignored.
# Safe to leave unset on new deployments; used only if no credentials are configured in the database.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
